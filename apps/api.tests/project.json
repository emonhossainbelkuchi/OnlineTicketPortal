{
  "name": "api.tests",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api.tests",
  "targets": {
    "restore": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet restore",
        "cwd": "apps/api.tests"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build TicketPortal.Api.Tests.csproj -c Release",
        "cwd": "apps/api.tests"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test",
        "cwd": "apps/api.tests"
      }
    }
  },
  "tags": ["type:test", "scope:backend"]
}
